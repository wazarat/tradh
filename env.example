# ---- tradh. environment (copy to apps/web/.env.local; never commit real values) ----

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=46630
# Optional: an Alchemy/other RPC for Robinhood Chain Testnet (public RPC is rate-limited)
NEXT_PUBLIC_RH_TESTNET_RPC_URL=
RH_TESTNET_RPC_URL=
# Optional: WalletConnect Cloud project id (injected wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Database (Supabase). DATABASE_URL = transaction pooler (port 6543), DIRECT_URL = direct (5432) for migrations.
# The Vercel Supabase integration sets POSTGRES_URL / POSTGRES_URL_NON_POOLING instead; both names are accepted.
DATABASE_URL=
DIRECT_URL=

# AI (Milestone 3): server-side only
ANTHROPIC_API_KEY=

# Feature flags (spec §20). Everything defaults to off; ENABLE_LIVE_MONEY is hard-pinned off in code.
ENABLE_MOCK_TRADING=true
ENABLE_MCP=false
ENABLE_STRATEGY_PROPOSALS=false
ENABLE_AUTOMATED_EXECUTION=false
ENABLE_BASIC_SIMULATION=false
ENABLE_HISTORICAL_BACKTESTING=false
ENABLE_PAID_RESEARCH=false
ENABLE_EXTERNAL_DEX_ROUTING=false
ENABLE_OWN_EXCHANGE=false
ENABLE_PROTOCOL_FEES=false
ENABLE_PERPETUALS=false
ENABLE_ERC8004=false
ENABLE_PUBLIC_STRATEGIES=false
ENABLE_STRATEGY_FOLLOWING=false
ENABLE_LIVE_MONEY=false

# Contracts: see packages/contracts/.env.example (DEPLOYER_PRIVATE_KEY lives there, never here)
